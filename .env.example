# ---------------------------------------------------------------------------
# AI Lead Recovery Platform — environment variables
# Copy to .env for local docker-compose development. Never commit real secrets.
# In production these come from Render environment/secret groups (see render.yaml).
# ---------------------------------------------------------------------------

# --- Core ---
ENVIRONMENT=local
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- Security ---
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30

# --- Database (Postgres) ---
# docker-compose provides these defaults; Render injects DATABASE_URL directly.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lead_recovery

# --- Redis (cache, rate-limit, arq queue) ---
REDIS_URL=redis://localhost:6379/0

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Public base URL Twilio uses to reach our webhooks (e.g. an ngrok tunnel locally)
PUBLIC_API_BASE_URL=http://localhost:8000

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
